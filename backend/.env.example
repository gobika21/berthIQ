# Copy this file to .env and add your Anthropic API key
# Never commit .env to git!

ANTHROPIC_API_KEY=your_api_key_here

# Free key from https://aisstream.io — powers the live AIS vessel-queue proxy
AISSTREAM_API_KEY=your_aisstream_key_here

# Optional — defaults shown. See README "Configuration".
# ALLOWED_ORIGINS=http://localhost:3000
# LLM_RATE_LIMIT_PER_MINUTE=6
# MONITOR_INTERVAL_SECONDS=120
# AUTO_ADVISORY=1
# AUTO_ADVISORY_MAX_PER_HOUR=6
# DEMO_MODE=1
# CLAUDE_MODEL=claude-opus-4-5
# CLAUDE_TIMEOUT_SECONDS=30
# CLAUDE_MAX_RETRIES=2
# CLAUDE_PRICE_INPUT_PER_MTOK=5
# CLAUDE_PRICE_OUTPUT_PER_MTOK=25
